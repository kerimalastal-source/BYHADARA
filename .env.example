# Canonical site origin; defaults to https://www.byhadara.com (the Vercel primary domain; byhadara.com redirects to it). Set it only if the primary domain changes.
SITE_URL=
# Search engine ownership tokens (meta-tag method); leave empty when verifying via DNS.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_VERIFICATION=
# Verified optional public business details (read server-side; redeploy after changes).
REAL_ESTATE_URL=
CONTACT_EMAIL=
CONTACT_PHONE=
# Contact form: requests are emailed through Resend (the same service as the HADARA Real Estate site).
# Without RESEND_API_KEY the forms stay disabled and show the email address and phone number instead.
RESEND_API_KEY=
# Inbox that receives every request; defaults to CONTACT_EMAIL (info@byhadara.com).
CONTACT_TO_EMAIL=
# Sender, on a domain verified in Resend, e.g. "BYHADARA Website <website@byhadara.com>".
CONTACT_FROM_EMAIL=
# Optional: also save every request in HubSpot (contact + note). A private app access token with the
# scopes crm.objects.contacts.read/write and crm.schemas.contacts.read/write.
HUBSPOT_ACCESS_TOKEN=
# Optional extra origins allowed to post the form (the site's own origin is always allowed).
INQUIRY_ALLOWED_ORIGINS=
# Optional shared rate limit (5 requests per IP per 15 minutes) via Upstash Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=
